# Conexión a la base de datos (SQLite en dev, PostgreSQL o volumen SQLite en Railway)
DATABASE_URL="file:./dev.db"

# Clave secreta obligatoria para tokens JWT de sesión (Mínimo 32 caracteres seguros)
JWT_SECRET="reemplazar_con_un_secreto_seguro_y_aleatorio_de_produccion"

# URL pública del sitio (usado para SEO, sitemap y robots)
SITE_URL="http://localhost:3000"

# Credenciales para el script de inicialización única del administrador (npm run seed)
ADMIN_EMAIL="admin@tudealer.com"
ADMIN_PASSWORD="CambiarEstaContrasena123!"
ADMIN_NAME="Administrador Dealer"

# Directorio de almacenamiento privado para documentos sensibles (fuera de public/)
# En Railway, puede mapearse a un volumen montado, ej: /app/storage/private
UPLOAD_DIR="storage/private"
