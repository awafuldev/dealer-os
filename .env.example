# ==============================================================================
# DEALER OS — Variables de Entorno para Producción (Railway / Servidor)
# ==============================================================================
# Configura estas variables en el panel de Railway > tu servicio > "Variables".
# NO subas este archivo con valores reales a GitHub ni a repositorios públicos.

# 1. Base de Datos (PostgreSQL en Railway)
# Al agregar un plugin de PostgreSQL en Railway, Railway genera automáticamente DATABASE_URL.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# 2. Seguridad & Autenticación
# Secreto para firmar tokens JWT de sesión (Mínimo 32 caracteres criptográficos aleatorios).
# Ejemplo para generar en terminal: openssl rand -base64 32
JWT_SECRET=

# 3. Administrador Inicial (Utilizado al ejecutar: npm run seed)
# Define el correo y la contraseña para tu cuenta de acceso inicial al sistema.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# 4. Configuración del Dealer (Opcional, se puede editar luego en /settings)
DEALER_NAME=
DEALER_PHONE=
DEALER_WHATSAPP=
DEALER_EMAIL=

# 5. URL Pública de la Aplicación
# La URL generada por Railway (ej: https://dealer-os.up.railway.app) o tu dominio propio.
SITE_URL=

# 6. Almacenamiento Persistente (Railway Volume)
# Ruta donde se almacenan los documentos privados de los clientes y contratos.
# En Railway, crea un Volume montado en: /app/storage/private
UPLOAD_DIR=/app/storage/private
